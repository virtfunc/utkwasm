diff --git a/pkg/visitors/findall_equiv_test.go b/pkg/visitors/findall_equiv_test.go
new file mode 100644
index 0000000..1fdefd1
--- /dev/null
+++ b/pkg/visitors/findall_equiv_test.go
@@ -0,0 +1,89 @@
+package visitors
+
+import (
+	"math/rand"
+	"reflect"
+	"testing"
+)
+
+// findAllNaive is the ORIGINAL implementation, kept here to verify the
+// optimized findAll returns identical results.
+func findAllNaive(p *hexPattern, data []byte) []int {
+	var offsets []int
+	for off := 0; off+p.Len() <= len(data); {
+		match := true
+		for i, mask := range p.mask {
+			if data[off+i]&mask != p.value[i] {
+				match = false
+				break
+			}
+		}
+		if match {
+			offsets = append(offsets, off)
+			off += p.Len()
+		} else {
+			off++
+		}
+	}
+	return offsets
+}
+
+func TestFindAllEquivalence(t *testing.T) {
+	rng := rand.New(rand.NewSource(42))
+	patterns := []string{
+		"AB",                                     // 1 byte fixed
+		"488BC448895808",                         // fully fixed, 7 bytes
+		"488BC4488958084889..184889..2048895010", // with wildcard nibbles
+		"....",                                   // fully wildcard single byte
+		"......",                                 // fully wildcard
+		"AB....CD",                               // mixed
+		"00",                                     // common byte (many candidates)
+		"FFFFFFFFFFFFFFFF",                       // 8 fixed bytes, rare
+		"A.",                                     // half byte
+		".A",                                     // other half
+	}
+	for trial := 0; trial < 300; trial++ {
+		// random data with a small alphabet so matches actually occur
+		n := rng.Intn(4096)
+		data := make([]byte, n)
+		for i := range data {
+			switch rng.Intn(4) {
+			case 0:
+				data[i] = byte(rng.Intn(256))
+			case 1:
+				data[i] = 0xAB
+			case 2:
+				data[i] = 0x48
+			case 3:
+				data[i] = 0x00
+			}
+		}
+		// inject pattern occurrences at random positions
+		if len(data) > 64 {
+			for k := 0; k < 3; k++ {
+				pat := patterns[rng.Intn(len(patterns))]
+				hp, err := compileHexPattern(pat)
+				if err != nil {
+					t.Fatalf("compile %q: %v", pat, err)
+				}
+				pos := rng.Intn(len(data) - hp.Len())
+				for i := 0; i < hp.Len(); i++ {
+					m := hp.mask[i]
+					v := byte(rng.Intn(256))
+					data[pos+i] = v&^m | hp.value[i]&m
+				}
+			}
+		}
+		for _, pat := range patterns {
+			hp, err := compileHexPattern(pat)
+			if err != nil {
+				t.Fatalf("compile %q: %v", pat, err)
+			}
+			want := findAllNaive(hp, data)
+			got := hp.findAll(data)
+			if !reflect.DeepEqual(want, got) {
+				t.Fatalf("pattern %q data len %d: naive %v != optimized %v", pat, len(data), want, got)
+			}
+		}
+	}
+}
