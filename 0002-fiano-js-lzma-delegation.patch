diff --git a/pkg/compression/jslzma_js.go b/pkg/compression/jslzma_js.go
new file mode 100644
index 0000000..d4ecae8
--- /dev/null
+++ b/pkg/compression/jslzma_js.go
@@ -0,0 +1,51 @@
+//go:build js && wasm
+
+package compression
+
+// Optional JS-side LZMA delegation for js/wasm builds.
+//
+// Pure-Go LZMA runs ~3x slower inside js/wasm than natively (branchy integer
+// code with bounds checks). When the host page provides global
+// utkLzmaCompress/utkLzmaDecompress functions (backed by a liblzma compiled
+// to wasm, e.g. the lzma-wasm package), the compressors delegate to them and
+// fall back to the pure-Go implementation when they are unavailable or fail.
+//
+// Contract:
+//   utkLzmaCompress(data: Uint8Array, level: number) -> Uint8Array   (LZMA-alone, lc=3 lp=0 pb=2, size in header)
+//   utkLzmaDecompress(data: Uint8Array, expectedSize: number) -> Uint8Array
+
+import (
+	"syscall/js"
+)
+
+func jsLzmaEncode(data []byte, level int) ([]byte, bool) {
+	fn := js.Global().Get("utkLzmaCompress")
+	if fn.Type() != js.TypeFunction {
+		return nil, false
+	}
+	in := js.Global().Get("Uint8Array").New(len(data))
+	js.CopyBytesToJS(in, data)
+	out := fn.Invoke(in, level)
+	if out.Type() != js.TypeObject || out.Length() == 0 {
+		return nil, false
+	}
+	buf := make([]byte, out.Length())
+	js.CopyBytesToGo(buf, out)
+	return buf, true
+}
+
+func jsLzmaDecode(data []byte, expectedSize int) ([]byte, bool) {
+	fn := js.Global().Get("utkLzmaDecompress")
+	if fn.Type() != js.TypeFunction {
+		return nil, false
+	}
+	in := js.Global().Get("Uint8Array").New(len(data))
+	js.CopyBytesToJS(in, data)
+	out := fn.Invoke(in, expectedSize)
+	if out.Type() != js.TypeObject || out.Length() == 0 {
+		return nil, false
+	}
+	buf := make([]byte, out.Length())
+	js.CopyBytesToGo(buf, out)
+	return buf, true
+}
