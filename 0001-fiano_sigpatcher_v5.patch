+package visitors
+
+import (
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/linuxboot/fiano/pkg/guid"
+	"github.com/linuxboot/fiano/pkg/uefi"
+)
+
+type FindPattern struct {
+	Predicate FindPredicate // files to search
+	Pattern   string        // hex pattern with optional '.' wildcards
+	W         io.Writer     // optional writer the matches are printed to
+	Matches   []PatternMatch
+}
+
+type PatternMatch struct {
+	GUID   guid.GUID        // GUID of the file the pattern was found in
+	Type   uefi.SectionType // type of the section the pattern was found in
+	Offset uint64           // offset within the image data, relative to the image without the section header
+}
+
+func (v *FindPattern) Run(f uefi.Firmware) error {
+	pattern, err := compileHexPattern(v.Pattern)
+	if err != nil {
+		return err
+	}
+	extract := &ExtractPE32{Predicate: v.Predicate}
+	if err := extract.Run(f); err != nil {
+		return err
+	}
+	for _, image := range extract.Images {
+		for _, off := range pattern.findAll(image.Data) {
+			v.Matches = append(v.Matches, PatternMatch{GUID: image.GUID, Type: image.Type, Offset: uint64(off)})
+		}
+	}
+	if v.W != nil {
+		for _, m := range v.Matches {
+			if _, err := fmt.Fprintf(v.W, "%v %v %#x\n", m.GUID, m.Type, m.Offset); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+func (v *FindPattern) Visit(f uefi.Firmware) error { return nil }
+
+func init() {
+	RegisterCLI("find_pattern", "find all occurrences of a hex pattern (with '.' wildcards) in the PE32/TE sections of the files with the given GUID", 2, func(args []string) (uefi.Visitor, error) {
+		g, err := guid.Parse(args[0])
+		if err != nil {
+			return nil, err
+		}
+		return &FindPattern{
+			Predicate: FindFileGUIDPredicate(*g),
+			Pattern:   args[1],
+			W:         os.Stdout,
+		}, nil
+	})
+}
