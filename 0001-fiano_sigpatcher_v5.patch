new file mode 100644
index 0000000..56a95c9
--- /dev/null
+++ b/pkg/visitors/hexpattern.go
@@ -0,0 +1,88 @@
+package visitors
+
+import (
+	"errors"
+	"fmt"
+)
+
+type hexPattern struct {
+	value []byte // pattern bytes with all wildcard bits cleared
+	mask  []byte // bit set for every pattern bit that is not a wildcard
+}
+
+func compileHexPattern(s string) (*hexPattern, error) {
+	if len(s) == 0 {
+		return nil, errors.New("pattern is empty")
+	}
+	if len(s)%2 != 0 {
+		return nil, fmt.Errorf("pattern %q has odd length, patterns must have two symbols per byte", s)
+	}
+	p := &hexPattern{value: make([]byte, len(s)/2), mask: make([]byte, len(s)/2)}
+	for i := 0; i < len(s); i += 2 {
+		hi, hiMask, err := hexSymbol(s[i])
+		if err != nil {
+			return nil, fmt.Errorf("pattern %q: %w", s, err)
+		}
+		lo, loMask, err := hexSymbol(s[i+1])
+		if err != nil {
+			return nil, fmt.Errorf("pattern %q: %w", s, err)
+		}
+		p.value[i/2] = hi<<4 | lo
+		p.mask[i/2] = hiMask<<4 | loMask
+	}
+	return p, nil
+}
+
+func hexSymbol(c byte) (value, mask byte, err error) {
+	switch {
+	case c == '.':
+		return 0, 0, nil
+	case '0' <= c && c <= '9':
+		return c - '0', 0xF, nil
+	case 'a' <= c && c <= 'f':
+		return c - 'a' + 10, 0xF, nil
+	case 'A' <= c && c <= 'F':
+		return c - 'A' + 10, 0xF, nil
+	}
+	return 0, 0, fmt.Errorf("invalid symbol %q, expected a hex digit or '.'", string(rune(c)))
+}
+
+func (p *hexPattern) Len() int { return len(p.value) }
+
+func (p *hexPattern) findAll(data []byte) []int {
+	var offsets []int
+	for off := 0; off+p.Len() <= len(data); {
+		match := true
+		for i, mask := range p.mask {
+			if data[off+i]&mask != p.value[i] {
+				match = false
+				break
+			}
+		}
+		if match {
+			offsets = append(offsets, off)
+			off += p.Len()
+		} else {
+			off++
+		}
+	}
+	return offsets
+}
+
+func patternSpan(data []byte, off uint64, n int) error {
+	remain := uint64(len(data)) - min(off, uint64(len(data)))
+	if uint64(n) > remain {
+		return fmt.Errorf("unable to apply pattern at offset %#x: only %d of the %d pattern bytes fit", off, remain, n)
+	}
+	return nil
+}
+
+func (p *hexPattern) applyAt(data []byte, off uint64) error {
+	if err := patternSpan(data, off, p.Len()); err != nil {
+		return err
+	}
+	for i, mask := range p.mask {
+		data[off+uint64(i)] = data[off+uint64(i)]&^mask | p.value[i]&mask
+	}
+	return nil
+}
diff --git a/pkg/visitors/patch.go b/pkg/visitors/patch.go
new file mode 100644
index 0000000..e7d6ac3
--- /dev/null
+++ b/pkg/visitors/patch.go
@@ -0,0 +1,345 @@
+package visitors
+
+import (
+	"bufio"
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"strconv"
+	"strings"
+
+	"github.com/linuxboot/fiano/pkg/guid"
+	"github.com/linuxboot/fiano/pkg/uefi"
+)
+
+const patchFileName = "patches.txt" // read when the patch command is used without arguments
+
+type PatchType byte
+
+const (
+	PatchTypePattern PatchType = 'P' // replace every occurrence of a find pattern
+	PatchTypeOffset  PatchType = 'O' // replace at a fixed hex offset
+)
+
+type PatchRule struct {
+	GUID        guid.GUID        // firmware file to patch
+	SectionType uefi.SectionType // PE32 or TE
+	Type        PatchType        // 'P' (pattern) or 'O' (offset)
+	Find        *hexPattern      // find pattern (PatchTypePattern)
+	RawFind     string           // find pattern as written in the patch string
+	Offset      uint64           // offset within the image data (PatchTypeOffset)
+	Replace     *hexPattern      // replacement pattern, '.' keeps the original nibble
+}
+
+// ParsePatchString parses "FileGuid SectionType PatchType:FindPatternOrOffset:ReplacePattern".
+func ParsePatchString(s string) (*PatchRule, error) {
+	fields := strings.Fields(s)
+	if len(fields) != 3 {
+		return nil, fmt.Errorf("patch string must consist of 3 fields: FileGuid SectionType PatchType:FindPatternOrOffset:ReplacePattern, got %d", len(fields))
+	}
+	g, err := guid.Parse(fields[0])
+	if err != nil {
+		return nil, err
+	}
+	sectionType, err := strconv.ParseUint(fields[1], 16, 8)
+	if err != nil {
+		return nil, fmt.Errorf("unable to parse section type %q: %w", fields[1], err)
+	}
+	if uefi.SectionType(sectionType) != uefi.SectionTypePE32 && uefi.SectionType(sectionType) != uefi.SectionTypeTE {
+		return nil, fmt.Errorf("unsupported section type %#x, only PE32 (10) and TE (12) sections can be patched", sectionType)
+	}
+	patchType, findParam, replaceParam, err := parsePatchSpec(fields[2])
+	if err != nil {
+		return nil, err
+	}
+	replace, err := compileHexPattern(replaceParam)
+	if err != nil {
+		return nil, fmt.Errorf("invalid replacement pattern: %w", err)
+	}
+	patch := &PatchRule{
+		GUID:        *g,
+		SectionType: uefi.SectionType(sectionType),
+		Type:        patchType,
+		RawFind:     findParam,
+		Replace:     replace,
+	}
+	switch patchType {
+	case PatchTypePattern:
+		find, err := compileHexPattern(findParam)
+		if err != nil {
+			return nil, fmt.Errorf("invalid find pattern: %w", err)
+		}
+		if find.Len() != replace.Len() {
+			return nil, fmt.Errorf("find pattern %q and replacement pattern %q have different lengths (%d and %d bytes), they must match for a pattern patch",
+				findParam, replaceParam, find.Len(), replace.Len())
+		}
+		patch.Find = find
+	case PatchTypeOffset:
+		patch.Offset, err = parsePatchOffset(findParam)
+		if err != nil {
+			return nil, err
+		}
+	}
+	return patch, nil
+}
+
+// ParsePatchFile parses one patch string per line; blank lines and '#' comments are skipped.
+func ParsePatchFile(r io.Reader) ([]*PatchRule, error) {
+	var patches []*PatchRule
+	scanner := bufio.NewScanner(r)
+	line := 0
+	for scanner.Scan() {
+		line++
+		s := strings.TrimSpace(scanner.Text())
+		if s == "" || strings.HasPrefix(s, "#") {
+			continue
+		}
+		patch, err := ParsePatchString(s)
+		if err != nil {
+			return nil, fmt.Errorf("line %d: %w", line, err)
+		}
+		patches = append(patches, patch)
+	}
+	if err := scanner.Err(); err != nil {
+		return nil, err
+	}
+	if len(patches) == 0 {
+		return nil, errors.New("no patches found")
+	}
+	return patches, nil
+}
+
+func parsePatchSpec(s string) (PatchType, string, string, error) {
+	parts := strings.Split(s, ":")
+	if len(parts) != 3 {
+		return 0, "", "", fmt.Errorf("patch specification %q must consist of 3 colon separated parts: PatchType:FindPatternOrOffset:ReplacePattern", s)
+	}
+	var patchType PatchType
+	switch parts[0] {
+	case "P":
+		patchType = PatchTypePattern
+	case "O":
+		patchType = PatchTypeOffset
+	default:
+		return 0, "", "", fmt.Errorf("unknown patch type %q, must be 'P' (pattern) or 'O' (offset)", parts[0])
+	}
+	if parts[1] == "" || parts[2] == "" {
+		return 0, "", "", fmt.Errorf("patch specification %q contains an empty parameter", s)
+	}
+	return patchType, parts[1], parts[2], nil
+}
+
+func parsePatchOffset(s string) (uint64, error) {
+	offset, err := strconv.ParseUint(strings.TrimPrefix(strings.TrimPrefix(s, "0x"), "0X"), 16, 64)
+	if err != nil {
+		return 0, fmt.Errorf("unable to parse offset %q: %w", s, err)
+	}
+	return offset, nil
+}
+
+type Patch struct {
+	PatchString string       // single patch string, used when Patches is nil
+	Patches     []*PatchRule // list of patches applied in order, takes precedence over PatchString
+	Lenient     bool         // skip patches which do not apply instead of failing
+	W           io.Writer    // a line is printed here for every applied patch
+	Patched     []PatchedSection
+	Skipped     []SkippedPatch
+}
+
+type PatchedSection struct {
+	GUID    guid.GUID        // GUID of the patched firmware file
+	Type    uefi.SectionType // type of the patched section
+	Offsets []uint64         // offsets within the image data
+}
+
+type SkippedPatch struct {
+	Patch *PatchRule // the skipped patch
+	Err   error      // why it was skipped
+}
+
+func (v *Patch) Run(f uefi.Firmware) error {
+	patches := v.Patches
+	if patches == nil {
+		if v.PatchString == "" {
+			return errors.New("no patch string given")
+		}
+		patch, err := ParsePatchString(v.PatchString)
+		if err != nil {
+			return err
+		}
+		patches = []*PatchRule{patch}
+	}
+	for _, patch := range patches {
+		if err := v.applyPatch(f, patch); err != nil {
+			var na *notApplicableError
+			if v.Lenient && errors.As(err, &na) {
+				v.Skipped = append(v.Skipped, SkippedPatch{Patch: patch, Err: err})
+				continue
+			}
+			return err
+		}
+	}
+	return nil
+}
+
+func (v *Patch) Visit(f uefi.Firmware) error { return nil }
+
+type notApplicableError struct{ err error }
+
+func notApplicable(err error) error { return &notApplicableError{err: err} }
+
+func (e *notApplicableError) Error() string { return e.err.Error() }
+func (e *notApplicableError) Unwrap() error { return e.err }
+
+func (v *Patch) applyPatch(f uefi.Firmware, patch *PatchRule) error {
+	extract := &ExtractPE32{
+		Predicate:   FindFileGUIDPredicate(patch.GUID),
+		SectionType: patch.SectionType,
+	}
+	if err := extract.Run(f); err != nil {
+		return err
+	}
+	if len(extract.Images) == 0 {
+		switch extract.MatchedFiles {
+		case 0:
+			return notApplicable(fmt.Errorf("no files with GUID %v found in the image", patch.GUID))
+		default:
+			return notApplicable(fmt.Errorf("none of the %d files with GUID %v contain a %v section", extract.MatchedFiles, patch.GUID, patch.SectionType))
+		}
+	}
+	for _, image := range extract.Images {
+		occurrences, err := patchImage(patch, image)
+		if err != nil {
+			if errors.Is(err, errPatternNotFound) {
+				if hints := patternHints(f, patch); len(hints) > 0 {
+					err = fmt.Errorf("%w; the pattern occurs in other files: %s", err, strings.Join(hints, ", "))
+				}
+			}
+			return err
+		}
+		name := uiName(image.File)
+		if name == "" {
+			name = image.GUID.String()
+		}
+		var offsets []uint64
+		for _, o := range occurrences {
+			if v.W != nil {
+				if _, err := fmt.Fprintf(v.W, "patch: replaced %d bytes at offset %Xh in %s %X -> %X\n", len(o.Old), o.Offset, name, o.Old, o.New); err != nil {
+					return err
+				}
+			}
+			offsets = append(offsets, o.Offset)
+		}
+		v.Patched = append(v.Patched, PatchedSection{GUID: image.GUID, Type: image.Type, Offsets: offsets})
+	}
+	return nil
+}
+
+var errPatternNotFound = errors.New("pattern not found")
+
+func patternHints(f uefi.Firmware, patch *PatchRule) []string {
+	if patch.Type != PatchTypePattern {
+		return nil
+	}
+	find := &FindPattern{
+		Predicate: func(f uefi.Firmware) bool { _, ok := f.(*uefi.File); return ok },
+		Pattern:   patch.RawFind,
+	}
+	if err := find.Run(f); err != nil {
+		return nil
+	}
+	var hints []string
+	for _, m := range find.Matches {
+		hints = append(hints, fmt.Sprintf("%v %v %#x", m.GUID, m.Type, m.Offset))
+		if len(hints) == 3 {
+			if extra := len(find.Matches) - len(hints); extra > 0 {
+				hints = append(hints, fmt.Sprintf("and %d more", extra))
+			}
+			break
+		}
+	}
+	return hints
+}
+
+type patchedOccurrence struct {
+	Offset uint64 // offset within the image data
+	Old    []byte // image data at the offset before the patch
+	New    []byte // image data at the offset after the patch
+}
+
+func patchImage(patch *PatchRule, image *ExtractedImage) ([]patchedOccurrence, error) {
+	if err := validateImageSignature(image.Type, image.Data); err != nil {
+		return nil, notApplicable(fmt.Errorf("file %v: %w", image.GUID, err))
+	}
+	var offsets []uint64
+	switch patch.Type {
+	case PatchTypePattern:
+		for _, off := range patch.Find.findAll(image.Data) {
+			offsets = append(offsets, uint64(off))
+		}
+		if len(offsets) == 0 {
+			return nil, notApplicable(fmt.Errorf("file %v: %w in %v section", image.GUID, errPatternNotFound, image.Type))
+		}
+	case PatchTypeOffset:
+		offsets = []uint64{patch.Offset}
+	}
+	n := patch.Replace.Len()
+	var occurrences []patchedOccurrence
+	for _, off := range offsets {
+		if err := patternSpan(image.Data, off, n); err != nil {
+			return nil, notApplicable(fmt.Errorf("file %v: %w", image.GUID, err))
+		}
+		old := append([]byte(nil), image.Data[off:off+uint64(n)]...)
+		if err := patch.Replace.applyAt(image.Data, off); err != nil {
+			return nil, notApplicable(fmt.Errorf("file %v: %w", image.GUID, err))
+		}
+		occurrences = append(occurrences, patchedOccurrence{
+			Offset: off,
+			Old:    old,
+			New:    append([]byte(nil), image.Data[off:off+uint64(n)]...),
+		})
+	}
+	if err := replaceExecSectionData(image.Section, image.Data); err != nil {
+		return nil, fmt.Errorf("file %v: %w", image.GUID, err)
+	}
+	return occurrences, nil
+}
+
+func uiName(f *uefi.File) string {
+	for _, s := range f.Sections {
+		if s.Header.Type == uefi.SectionTypeUserInterface {
+			return s.Name
+		}
+	}
+	return ""
+}
+
+func validateImageSignature(t uefi.SectionType, data []byte) error {
+	want := "MZ"
+	if t == uefi.SectionTypeTE {
+		want = "VZ"
+	}
+	if !bytes.HasPrefix(data, []byte(want)) {
+		return fmt.Errorf("extracted %v image does not start with the expected %q signature", t, want)
+	}
+	return nil
+}
+
+func init() {
+	RegisterCLIRange("patch", `patch the PE32/TE image of a file with a UEFIPatch style patch string "FileGuid SectionType PatchType:FindPatternOrOffset:ReplacePattern" (SectionType: PE32=10, TE=12; PatchType: P=pattern, O=offset); a line is printed for every applied patch; without an argument the patches are read from patches.txt in the current directory, one patch per line with '#' comments, and patches which do not apply are silently skipped`, 0, 1, func(args []string) (uefi.Visitor, error) {
+		if len(args) == 0 {
+			data, err := os.ReadFile(patchFileName)
+			if err != nil {
+				return nil, err
+			}
+			patches, err := ParsePatchFile(bytes.NewReader(data))
+			if err != nil {
+				return nil, fmt.Errorf("%s: %w", patchFileName, err)
+			}
+			return &Patch{Patches: patches, Lenient: true, W: os.Stdout}, nil
+		}
+		return &Patch{PatchString: args[0], W: os.Stdout}, nil
+	})
