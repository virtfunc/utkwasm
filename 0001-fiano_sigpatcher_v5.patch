--- /dev/null
+++ b/pkg/visitors/extractpe32.go
@@ -0,0 +1,119 @@
+package visitors
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/linuxboot/fiano/pkg/guid"
+	"github.com/linuxboot/fiano/pkg/uefi"
+)
+
+type ExtractPE32 struct {
+	Predicate    FindPredicate    // files to extract images from
+	SectionType  uefi.SectionType // PE32, PIC or TE; zero value selects all of them
+	Path         string           // optional directory to write the images to
+	Images       []*ExtractedImage
+	MatchedFiles int // number of files which matched the Predicate
+	currentFile  *uefi.File
+}
+
+type ExtractedImage struct {
+	File    *uefi.File       // firmware file the image was extracted from
+	Section *uefi.Section    // section the image was extracted from
+	GUID    guid.GUID        // GUID of the file
+	Type    uefi.SectionType // PE32, PIC or TE
+	Data    []byte           // image data, without the section header
+}
+
+func (v *ExtractPE32) Run(f uefi.Firmware) error {
+	find := Find{Predicate: v.Predicate}
+	if err := find.Run(f); err != nil {
+		return err
+	}
+	v.MatchedFiles = len(find.Matches)
+	for _, m := range find.Matches {
+		if err := m.Apply(v); err != nil {
+			return err
+		}
+	}
+	return v.writeImages()
+}
+
+func (v *ExtractPE32) Visit(f uefi.Firmware) error {
+	switch f := f.(type) {
+	case *uefi.File:
+		old := v.currentFile
+		v.currentFile = f
+		err := f.ApplyChildren(v)
+		v.currentFile = old
+		return err
+	case *uefi.Section:
+		if v.currentFile != nil && wantedImageSection(v.SectionType, f.Header.Type) {
+			data, err := sectionImageData(f)
+			if err != nil {
+				return err
+			}
+			v.Images = append(v.Images, &ExtractedImage{
+				File:    v.currentFile,
+				Section: f,
+				GUID:    v.currentFile.Header.GUID,
+				Type:    f.Header.Type,
+				Data:    data,
+			})
+		}
+		return f.ApplyChildren(v)
+	default:
+		return f.ApplyChildren(v)
+	}
+}
+
+func (v *ExtractPE32) writeImages() error {
+	if v.Path == "" || len(v.Images) == 0 {
+		return nil
+	}
+	if err := os.MkdirAll(v.Path, 0755); err != nil {
+		return err
+	}
+	counters := map[string]int{}
+	for _, image := range v.Images {
+		stem := image.GUID.String()
+		ext := ".efi"
+		if image.Type == uefi.SectionTypeTE {
+			ext = ".te"
+		}
+		counters[stem]++
+		filename := stem + ext
+		if counters[stem] > 1 {
+			filename = fmt.Sprintf("%s_%d%s", stem, counters[stem], ext)
+		}
+		if err := os.WriteFile(filepath.Join(v.Path, filename), image.Data, 0666); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func wantedImageSection(want, t uefi.SectionType) bool {
+	switch want {
+	case uefi.SectionTypePE32, uefi.SectionTypePIC, uefi.SectionTypeTE:
+		return want == t
+	case uefi.SectionTypeAll:
+		return t == uefi.SectionTypePE32 || t == uefi.SectionTypePIC || t == uefi.SectionTypeTE
+	}
+	return false
+}
+
+func sectionImageData(s *uefi.Section) ([]byte, error) {
+	headerLen := uint64(uefi.SectionMinLength)
+	if s.Header.Size == [3]uint8{0xFF, 0xFF, 0xFF} {
+		headerLen = uefi.SectionExtMinLength
+	}
+	buf := s.Buf()
+	if uint64(len(buf)) < headerLen {
+		return nil, fmt.Errorf("section of type %v is too short to contain a section header", s.Header.Type)
+	}
+	data := make([]byte, uint64(len(buf))-headerLen)
+	copy(data, buf[headerLen:])
+	return data, nil
+}
