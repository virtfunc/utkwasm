+
+func fileLayoutOffset(file *uefi.File, fileOffset uint64) (alignedOffset, insertOffset uint64) {
+	alignedOffset = uefi.Align8(fileOffset)
+	insertOffset = alignedOffset
+	if alignBase := file.Header.Attributes.GetAlignment(); alignBase != 1 {
+		hl := file.HeaderLen() // the data, not the header, must be aligned
+		fileDataOffset := uefi.Align(alignedOffset+hl, alignBase)
+		newOffset := fileDataOffset - hl
+		if gap := newOffset - alignedOffset; gap >= 8 && gap < uefi.FileHeaderMinLength {
+			fileDataOffset = uefi.Align(fileDataOffset+1, alignBase) // no room for a pad file, re-align
+			newOffset = fileDataOffset - hl
+		}
+		insertOffset = newOffset
+	}
+	return alignedOffset, insertOffset
+}
+
+func fvLayoutEnd(f *uefi.FirmwareVolume) uint64 { // offset just past the last file
+	fileOffset := f.DataOffset
+	for _, file := range f.Files {
+		_, insertOffset := fileLayoutOffset(file, fileOffset)
+		fileOffset = insertOffset + uint64(len(file.Buf()))
+	}
+	return fileOffset
+}
+
+func shrinkPadFiles(f *uefi.FirmwareVolume, need uint64) uint64 { // shrink pads by up to need bytes, from the last one backwards, never below the header size
+	var removed uint64
+	for i := len(f.Files) - 1; i >= 0 && need > 0; i-- {
+		file := f.Files[i]
+		if file.Header.Type != uefi.FVFileTypePad {
+			continue
+		}
+		size := uint64(len(file.Buf()))
+		if size <= uefi.FileHeaderMinLength {
+			continue
+		}
+		shrink := uefi.Align8(need) // whole 8 byte blocks so the following files keep their position
+		if max := size - uefi.FileHeaderMinLength; shrink > max {
+			shrink = max
+		}
+		pfile, err := uefi.CreatePadFile(size - shrink)
+		if err != nil {
+			break
+		}
+		f.Files[i] = pfile
+		removed += shrink
+		if shrink >= need {
+			need = 0
+		} else {
+			need -= shrink
+		}
+	}
+	return removed
+}
+
+func reusableOriginalStream(s *uefi.Section, ts *uefi.SectionGUIDDefined, compressor compression.Compressor, secData []byte) ([]byte, bool) { // original stream when it still decodes to exactly secData
+	buf := s.Buf()
+	if int(ts.DataOffset) >= len(buf) {
+		return nil, false // no original stream, e.g. a newly created section
+	}
+	orig := buf[ts.DataOffset:]
+	decoded, err := compressor.Decode(orig)
+	if err != nil {
+		return nil, false
+	}
+	return orig, bytes.Equal(decoded, secData)
+}
